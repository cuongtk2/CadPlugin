<Window x:Class="HcPdfPrinter.ViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HcPdf Writer" Width="1200" Height="800"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="3"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFDCDCDC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFC8C8C8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#FFF0F0F0">
            <Button Content="" 
                    ToolTip="Open PDF"
                    FontFamily="Segoe Fluent Icons" FontSize="18"
                    Margin="4" Padding="12,3" Click="OpenPdf_Click"/>
            <Button Content="" 
                    ToolTip="Save"
                    FontFamily="Segoe Fluent Icons" FontSize="18"
                    Margin="0,4,4,4" Padding="12,3"  Click="Save_Click"/>
            <Separator Margin="4,2"/>
            <Button Content="" 
                    ToolTip="Rotate Left"
                    FontFamily="Segoe Fluent Icons" FontSize="18"
                    Margin="0,4,4,4" Padding="10,3" Click="RotateLeft_Click"/>
            <Button Content="" 
                    ToolTip="Rotate Right"
                    FontFamily="Segoe Fluent Icons" FontSize="18"
                    Margin="0,4,4,4" Padding="10,3" Click="RotateRight_Click"/>
            <Button Content="" 
                    ToolTip="Move Up"
                    FontFamily="Segoe Fluent Icons" FontSize="18"
                    Margin="0,4,4,4" Padding="10,3" Click="MoveUp_Click"/>
            <Button Content="" 
                    ToolTip="Move Down"
                    FontFamily="Segoe Fluent Icons" FontSize="18"
                    Margin="0,4,4,4" Padding="10,3" Click="MoveDown_Click"/>
            <Button Content="" 
                    ToolTip="Delete"    
                    FontFamily="Segoe Fluent Icons" FontSize="18"
                    Margin="0,4,4,4" Padding="10,3" Click="Delete_Click"/>
            <Separator Margin="4,2"/>
            <Button Content="" 
                    ToolTip="Fit Width"
                    FontFamily="Segoe Fluent Icons" FontSize="18"
                    Margin="0,4,4,4" Padding="10,3" Click="FitWidth_Click"/>
            <Button Content="100%" Margin="0,4,4,4" Padding="10,3" Click="Zoom100_Click"/>
            <Button Content="−" 
                    ToolTip="Zoom Out"
                    FontWeight="DemiBold"
                    FontSize="18"
                    Margin="0,4,4,4" Padding="12,3" Click="ZoomOut_Click"/>
            <Button Content="+" 
                    ToolTip="Zoom In"
                    FontSize="18" FontWeight="DemiBold"
                    Margin="0,4,4,4" Padding="12,3" Click="ZoomIn_Click"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="160"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="PageList" Grid.Column="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="PageList_SelectionChanged"
                     KeyDown="PageList_KeyDown">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <EventSetter Event="GotKeyboardFocus" Handler="Item_GotKeyboardFocus"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="2" Padding="2,1" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <ScrollViewer x:Name="Scroller" Grid.Column="2"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Background="#FF7F7F7F"
                          PreviewMouseWheel="Scroller_PreviewMouseWheel">
                <Border Margin="16" Background="White" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Image x:Name="PageImage" Stretch="Fill"/>
                </Border>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2" Background="#FFF0F0F0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Margin="6,3" VerticalAlignment="Center"/>
            <TextBlock x:Name="PageNumber" Grid.Column="1" Margin="6,3" VerticalAlignment="Center"
               Text="CopyRight by Hùng Mạnh Cường, Zalo: 0903 492 234"/>
        </Grid>

    </Grid>
</Window>
